{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:org.topology-lantern:analog-sizing-benchmark:1",
  "title": "TopologyLantern analog sizing benchmark v1",
  "type": "object",
  "required": [
    "schema", "version", "model", "disclaimer", "provenance", "source",
    "candidates", "sizing", "objectives", "constraints", "expected_metrics",
    "contract_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "org.topology-lantern.analog-sizing-benchmark"},
    "version": {"const": 1},
    "model": {"const": "deterministic-analytic-proxy-v1"},
    "disclaimer": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["data_source", "license", "generation_command"],
      "additionalProperties": false,
      "properties": {
        "data_source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "generation_command": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["spec_sha256", "candidate_count", "supply_voltage"],
      "additionalProperties": false,
      "properties": {
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_count": {"type": "integer", "minimum": 1},
        "supply_voltage": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "signature", "device_count", "transistor_count",
          "passive_count", "stage_count", "headroom_units", "symmetry_penalty"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^TL-[0-9a-f]{12}$"},
          "signature": {"$ref": "#/$defs/sha256"},
          "device_count": {"type": "integer", "minimum": 0},
          "transistor_count": {"type": "integer", "minimum": 0},
          "passive_count": {"type": "integer", "minimum": 0},
          "stage_count": {"type": "integer", "minimum": 0},
          "headroom_units": {"type": "integer", "minimum": 0},
          "symmetry_penalty": {"type": "integer", "minimum": 0}
        }
      }
    },
    "sizing": {
      "type": "object",
      "required": ["width_um", "length_um", "bias_ua", "compensation_pf"],
      "additionalProperties": false,
      "properties": {
        "width_um": {"$ref": "#/$defs/log_bounds"},
        "length_um": {"$ref": "#/$defs/log_bounds"},
        "bias_ua": {"$ref": "#/$defs/log_bounds"},
        "compensation_pf": {"$ref": "#/$defs/log_bounds"}
      }
    },
    "objectives": {
      "type": "array",
      "prefixItems": [
        {"const": "power_mw"}, {"const": "area_um2"}, {"const": "bandwidth_mhz"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "constraints": {
      "type": "object",
      "required": ["gain_db_min", "phase_margin_deg_min"],
      "additionalProperties": false,
      "properties": {
        "gain_db_min": {"type": "number", "exclusiveMinimum": 0},
        "phase_margin_deg_min": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 180
        }
      }
    },
    "expected_metrics": {
      "type": "array",
      "prefixItems": [
        {"const": "gain_db"}, {"const": "phase_margin_deg"},
        {"const": "power_mw"}, {"const": "area_um2"}, {"const": "bandwidth_mhz"}
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "log_bounds": {
      "type": "object",
      "required": ["low", "high", "scale"],
      "additionalProperties": false,
      "properties": {
        "low": {"type": "number", "exclusiveMinimum": 0},
        "high": {"type": "number", "exclusiveMinimum": 0},
        "scale": {"const": "log"}
      }
    }
  }
}
